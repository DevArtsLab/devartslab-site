/**
 * ============================================================================
 * devartslab-site — DevArts Lab landing page
 * ============================================================================
 * devartslab.com/www -> landing page
 * docs.devartslab.com is served by the devartslab-notion Worker (separate repo)
 * ============================================================================
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devartslab-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "routes": [
    { "pattern": "devartslab.com/*", "zone_name": "devartslab.com" },
    { "pattern": "www.devartslab.com/*", "zone_name": "devartslab.com" },
  ],

  "vars": {
    "MAIL_DOMAIN": "devartslab.com",
    "DOCS_HOSTNAME": "docs.devartslab.com",
  },
}
